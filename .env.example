# ============================================================================
# MDIO 实例配置样板（.env.example）
#
# 规范位置（2026-10-11 收口）：
#   · 实例级真配置 = `$MDIO_HOME/.env`
#       安装态（uv tool / console script / systemd）= `~/.mdio/.env`
#       源码态（just / uv run / 直跑源码树）      = `<仓库根>/.env`
#   · 本样板会随 wheel 打包为 `mdio_py/env.example`；安装态**首跑**会在
#     `$MDIO_HOME/.env` 不存在时据此落地一份（可用 MDIO_ENV_NO_SEED=1 关闭）。
#   · 回退链（逐键 setdefault，先到先得；shell 显式导出优先级最高）：
#       1) `$MDIO_HOME/.env`   2) `<runtime_root>/.env`   3) 打包样板（全注释 ⇒ 零注入）
#   · 所有键默认注释：不写 = 用代码默认值。改完需**重启进程**才生效。
#   · 排查用：`MDIO_ENV_DEBUG=1` 会打印实际命中哪个文件、注入几个键。
# ============================================================================

# --- Gateway ---
# MDIO_GATEWAY_HOST=127.0.0.1
# MDIO_GATEWAY_PORT=8011

# --- iroh 集成测试端口（可选，默认 18101/18102）---
# MDIO_TEST_PORT_A=18101
# MDIO_TEST_PORT_B=18102

# --- UI (Vite dev server) ---
# MDIO_UI_HOST=127.0.0.1
# MDIO_UI_PORT=5174
# VITE_MDIO_GATEWAY_URL=ws://127.0.0.1:8011/ws/gateway

# --- Demo UI (Vite dev server, 仅前端) ---
# MDIO_DEMO_HOST=127.0.0.1
# MDIO_DEMO_PORT=5178
# VITE_DEMO_GATEWAY_URL=ws://127.0.0.1:8011/ws/gateway
# VITE_DEMO_CLI_URL=ws://127.0.0.1:8011/ws/cli

# --- Core / Runtime ---
# MDIO_DEBUG=false
# 统一工作区路径（不指定：安装态 = `~/.mdio/genesis`；源码态 = `<仓库根>/workspace`）
# MDIO_WORKSPACE_ROOT=./workspace

# 投影模式（**进程级**，启动读一次；切换需重启进程）：
#   默认 **hs**（2026-10-11 起，此前默认 cf）。显式 `cf` 才切到 Cf —— Cf 下树是
#   扁平的：声明装载与选择器全 0，仅供 A/B 与回归对照。
# MDIO_PROJ_MODE=cf

# patch 粒度（进程级）：block（默认）| proj。HS + proj 才走标准 6902 路径形态字段写。
# MDIO_PATCH_GRANULARITY=proj

# 持久化开关：安装态默认 1（由 _env.py 的 site-packages 分支给出）；显式 0 关闭。
# MDIO_PERSIST=0

# --- Telemetry 容量 ---
# MDIO_TELEMETRY_MAX_EVENTS=65536
# MDIO_TELEMETRY_MAX_META_POOL=8388608
# MDIO_TELEMETRY_BENCH_SAMPLES_PER_PHASE=200000
# MDIO_TELEMETRY_MAX_LAYER_SAMPLES=200000

# --- Plugins ---
# MDIO_PLUGIN_PATH=./plugins_repo

# --- 诊断 ---
# 打印 env 解析链（命中哪个文件、注入几个键、是否落地样板）
# MDIO_ENV_DEBUG=1
# 安装态首跑不自动落地 `$MDIO_HOME/.env`
# MDIO_ENV_NO_SEED=1
